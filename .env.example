DATABASE_URL=postgresql://usuario:password@localhost:5432/empremas
JWT_SECRET=cambiar-esto-por-un-valor-secreto-largo
PORT=3001

# Conector propio de facturación electrónica (EMPREMAS-SIFEN).
# SIFEN_CONECTOR_TOKEN debe coincidir con API_TOKEN del conector.
SIFEN_CONECTOR_URL=http://127.0.0.1:3100
SIFEN_CONECTOR_TOKEN=

# Fotos de servicios (galería de Reservas públicas) - cuenta gratuita en
# https://cloudinary.com, datos en el dashboard de esa cuenta.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
